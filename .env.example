# Tomu environment — copy to .env and fill in. NEVER commit .env (it is gitignored).
# In development the server auto-loads this via `tsx --env-file-if-exists=../../.env`.
# In production, run node with `--env-file=.env` (the bundled pm2 config does this).

# ── API server (packages/server) ────────────────────────────────────────────
# Port + bind host. In production, bind loopback and put nginx in front.
PORT=3456
HOST=127.0.0.1                     # dev can use 0.0.0.0
NODE_ENV=production                # development | production

# Postgres 16 connection string.
DATABASE_URL=postgres://filmlog:CHANGE_ME@localhost:5432/filmlog

# Secret used to sign/verify auth JWTs. MUST be a strong random value in prod.
#   generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Allowed browser origin for CORS (your client's URL).
CORS_ORIGIN=https://tomu.example.com

# ── MCP server (packages/mcp) — lets Claude use Tomu as a tool ───────────────
# Listens on loopback; nginx proxies /<path-secret>/mcp to it.
MCP_PORT=3457

# Auth for the MCP endpoint. Set at least one; setting both is fine.
#   TOMU_MCP_TOKEN       -> clients send `Authorization: Bearer <token>`
#   TOMU_MCP_PATH_SECRET -> secret URL segment: https://host/<secret>/mcp
#   generate each: openssl rand -hex 32   (path secret: openssl rand -hex 16)
TOMU_MCP_TOKEN=CHANGE_ME
TOMU_MCP_PATH_SECRET=CHANGE_ME

# How the MCP server reaches the API, and the token it authenticates with.
# TOMU_API_TOKEN is a JWT signed with JWT_SECRET whose `sub` is your user id.
# See docs/SELF-HOSTING.md for how to mint it.
TOMU_API_URL=http://localhost:3456/api/v1
TOMU_API_TOKEN=CHANGE_ME
